# PedidoPro backend PHP — variáveis de ambiente
# Copie para `.env` (fora do webroot público) e preencha. NÃO versionar o .env real.

# --- Banco (MySQL da HostGator / cPanel "MySQL Databases") ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=espac793_pedidopro
DB_USER=espac793_pedidopro
DB_PASS=troque-aqui

# --- Auth ---
# Pelo menos 16 chars. Gere algo aleatório e longo.
JWT_SECRET=troque-por-uma-chave-bem-grande
JWT_EXPIRES_DAYS=7

# --- Evolution API (WhatsApp) — roda no PC, exposta pelo tunnel ---
EVOLUTION_API_URL=https://evolution.guimarques.dev.br
EVOLUTION_API_KEY=troque-pela-chave-global
EVOLUTION_INSTANCE=pedidopro

# --- IA local (Ollama no PC, exposto pelo tunnel) ---
OLLAMA_URL=https://ollama.guimarques.dev.br
# Modelo de TEXTO (extração de preços). Em CPU, use um modelo leve/rápido.
OLLAMA_MODEL=qwen2.5:3b
# Modelo de VISÃO (futuro: extrair de fotos). Pesado em CPU — não usar p/ texto.
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Token de serviço do Cloudflare Access (se proteger o ollama.*). Opcional.
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=

# --- Sincronização da caixa de entrada (cron do cPanel chama bin/sync-inbox.php) ---
INBOX_SYNC_DAYS=2
INBOX_SYNC_ENABLED=true

# --- Clientes Empresariais: pedidos lidos do grupo de WhatsApp (bin/marmitex-wa.php) ---
# Segredo da rota pública POST /api/webhooks/evolution. VAZIO = rota fechada (401).
# Configure o webhook da instância apontando para
#   https://SEU-DOMINIO/api/webhooks/evolution   com o header x-webhook-secret
# e o evento MESSAGES_UPSERT.
MARMITEX_WA_WEBHOOK_SECRET=
# Ritmo do worker: intervalo do laço e da varredura de segurança (ms).
MARMITEX_WA_INTERVAL_MS=60000
MARMITEX_WA_SWEEP_MS=300000
# Janela da varredura: ignora mensagem mais velha que isto (evita reimportar histórico).
MARMITEX_WA_SYNC_HOURS=14
# Tenta entender a linha por regras antes de chamar a IA (economiza minutos de CPU).
MARMITEX_WA_RULES_FIRST=1
# Travas de segurança do modo automático.
MARMITEX_WA_MAX_AUTO_LINES=60
MARMITEX_WA_MAX_QTY=10
MARMITEX_WA_MAX_ATTEMPTS=3
# Fuso usado para decidir a data do pedido (mensagem das 8h é do dia de hoje AQUI).
APP_TZ=America/Sao_Paulo

# --- Caixa de entrada do WhatsApp (janela flutuante da barra superior) ---
# Varredura de reconciliação: relê na Evolution as conversas que mudaram e o
# webhook não trouxe. É a garantia de não perder mensagem.
WA_INBOX_SWEEP_MS=120000
# Retenção do espelho local (dias). Espelhar conversa é guardar dado pessoal de
# cliente — 0 desliga a limpeza e guarda para sempre.
WA_INBOX_RETENTION_DAYS=90
# Organização dona do inbox. O webhook é rota pública, sem usuário logado de quem
# herdar o tenant, e a instância da Evolution é uma só. 1 = org padrão do ERP.
WA_INBOX_ORG_ID=1

# --- Delivery (agregador iFood + 99Food) ---
# Bases das APIs (ajuste se a plataforma indicar outra URL).
IFOOD_API_BASE=https://merchant-api.ifood.com.br
NINE_NINE_API_BASE=https://openapi.didi-food.com
# Token interno que protege POST /api/delivery/poll (cron chama com ?token= ou header x-poll-token).
DELIVERY_POLL_TOKEN=troque-por-um-token-aleatorio
# Intervalo entre iterações do poller (ms). bin/poll.php faz 3 iterações por execução de cron.
DELIVERY_POLL_INTERVAL_MS=20000
# Conclusão automática LOCAL: move pedidos despachados p/ "Concluídos" após N minutos.
# 0 = off (produção, pois o iFood manda o evento CONCLUDED real). Use ex.: 2 só p/ homologar.
DELIVERY_AUTO_CONCLUDE_MIN=0
# Modo mock: não chama as plataformas (dev local / testes de webhook). 1 = ativo.
INTEGRATIONS_MOCK=0
# 99Food: exigir a assinatura do callback (didi-header-sign = MD5(corpo.app_secret)).
# 0 = só loga divergência e aceita (rollout: confirme no log que bate antes de exigir).
# 1 = rejeita callback com assinatura inválida (ligar depois de validar no tráfego real).
DELIVERY_99FOOD_ENFORCE_SIGN=0
# Credenciais por loja (client_id/secret/merchant_id/webhook_secret) ficam na tabela `channels`, não aqui.

# --- Geocodificação (mapa de pedidos Delivery) — Nominatim/OpenStreetMap, gratuito ---
# User-Agent obrigatório pela política de uso do Nominatim (rejeita requisições sem um).
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=PedidoPro/1.0 (contato: seu-email@dominio.com)

# --- CORS (vazio quando a API está na mesma origem do frontend) ---
# Liste origens separadas por vírgula se a API ficar em subdomínio diferente.
CORS_ORIGINS=

# dev | production
APP_ENV=production
