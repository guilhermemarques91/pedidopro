# Copie para `.env` (na raiz, ao lado do docker-compose.yml) e ajuste antes de subir.
# O Compose lê este arquivo automaticamente. NÃO versionar o .env real.

# --- Portas ---
APP_PORT=8090          # porta HTTP do app na LAN (http://IP-do-servidor:8090)
                       # (8080 costuma estar ocupada pela Evolution API neste PC)
DB_PORT_HOST=3307      # porta do MySQL exposta no host (opcional, p/ inspeção)

# --- Banco (MySQL local no container) ---
DB_NAME=pedidopro
DB_USER=pedidopro
DB_PASS=troque-esta-senha
DB_ROOT_PASS=troque-a-senha-root

# --- Auth (mín. 16 chars) ---
JWT_SECRET=troque-por-uma-chave-bem-grande-e-aleatoria

# dev | production
APP_ENV=production

# Integrações externas em modo mock durante o bootstrap (1 = sem chamadas externas).
INTEGRATIONS_MOCK=1
